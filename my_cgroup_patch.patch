+/**
+ * mem_cgroup_charge_anon_folio - Charge anonymous memory to memcg
+ * @folio: folio to charge
+ * @memcg: memory cgroup
+ *
+ * Charges anonymous memory to the memory cgroup. Should be called
+ * after allocating anonymous folio but before adding it to page tables.
+ */
+void mem_cgroup_charge_anon_folio(struct folio *folio, struct mem_cgroup *memcg)
+{
+    unsigned int nr_pages;
+    
+    if (!memcg || !folio)
+        return;
+    
+    nr_pages = folio_nr_pages(folio);
+    
+    /* Set folio->memcg_data connection */
+    folio->memcg_data = (unsigned long)memcg | MEMCG_DATA_OBJCGS;
+    
+    /* Charge the memory to cgroup */
+    spin_lock(&memcg->anon_lock);
+    page_counter_charge(&memcg->anonmem, nr_pages);
+    spin_unlock(&memcg->anon_lock);
+}
+EXPORT_SYMBOL_GPL(mem_cgroup_charge_anon_folio);
